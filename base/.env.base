# Must match the image tag in docker-compose.yml; the containers refuse to start otherwise.
BETTERLYTICS_VERSION=vX.Y.Z

# Names shared with the ClickHouse and Postgres containers. App defaults live in the image.

# Clickhouse database
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=admin
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1
CLICKHOUSE_BACKEND_USER=backend
CLICKHOUSE_DASHBOARD_USER=dashboard

# Postgres database
POSTGRES_DB=dashboard
POSTGRES_USER=user
