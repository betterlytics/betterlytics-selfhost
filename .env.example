# ===========================================
# Betterlytics Self-Hosted Configuration
# ===========================================
# Copy this file to .env and fill in the values,
# or run ./setup.sh to generate it interactively.

# --- Address ---
# The full address browsers use: scheme, host and, if non-standard, the port. No path.
# Examples: https://analytics.example.com, https://analytics.example.com:8443.
# Logins only work from exactly this address.
# Use http:// only when browsers reach Betterlytics over plain HTTP with no TLS anywhere
# (a local trial, or an IP address on a trusted network). Passwords then travel unencrypted.
PUBLIC_URL=https://analytics.example.com

# "off" (default): the container serves plain HTTP, for use behind your own reverse proxy,
# for a local trial (PUBLIC_URL=http://localhost:5566) or on a trusted LAN.
# "auto": built-in Let's Encrypt. Needs an https:// PUBLIC_URL with a public hostname and no port,
# HTTP_PORT=80, BIND_ADDRESS=0.0.0.0 and a port 443 mapping
# (setup.sh "Standalone" writes all of it, the 443 mapping into docker-compose.override.yml).
# Writing the override by hand? Set BL_HTTPS_PUBLISHED=true next to the 443 mapping,
# or the container refuses to start:
#   services:
#     betterlytics-selfhost:
#       ports:
#         - "0.0.0.0:443:443"
#       environment:
#         - BL_HTTPS_PUBLISHED=true
#     betterlytics-init:
#       environment:
#         - BL_HTTPS_PUBLISHED=true
TLS=off

# Optional: email for Let's Encrypt certificate registration.
# If not set, certificates are registered without an email.
# SSL_EMAIL=admin@example.com

# Optional: ACME directory. Use Let's Encrypt staging to test issuance without rate limits.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Network (advanced) ---
# Host address and port the container's HTTP port is published on.
# The defaults fit a reverse proxy on the same machine. TLS=auto needs 0.0.0.0 and 80.
# BIND_ADDRESS=127.0.0.1
# HTTP_PORT=5566

# Optional: reverse proxies on non-private addresses whose X-Forwarded-For should be trusted.
# Space-separated IPs or CIDRs. Private ranges (10/8, 172.16/12, 192.168/16, loopback) are always trusted.
# TRUSTED_PROXIES=203.0.113.5 198.51.100.0/24

# Optional, only behind your own reverse proxy: the address it connects from, shown as request.remote_ip
# in `docker compose logs betterlytics-selfhost`. Without it, all sign-in attempts share one rate limit.
# Space-separated IPs or CIDRs. Add your TRUSTED_PROXIES entries here too.
# AUTH_TRUSTED_PROXIES=172.18.0.1

# --- Base Secret ---
# Every database password and auth key is derived from this value.
# Use at least 32 random characters, e.g. the output of: openssl rand -hex 32
# (setup.sh generates one). Nothing starts while it is empty, and the app logs a warning
# at every start while it is shorter than 32 characters. Set it before the first start and
# keep it: the databases are created with passwords derived from it.
SECRET_BASE=

# --- Email ---
# Set to true to enable sending emails (e.g. reports, alerts).
ENABLE_EMAILS=false

# Required when ENABLE_EMAILS=true, for both MailerSend and SMTP; without it the app will not start.
# Format: "Name <address>" or a bare address.
# SMTP_FROM=Betterlytics <noreply@example.com>

# If you use MailerSend, set the API token below (no SMTP server config needed).
# MAILER_SEND_API_TOKEN=

# For other providers, configure SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Geolocation ---
ENABLE_GEOLOCATION=false
MAXMIND_ACCOUNT_ID=xxxxx
MAXMIND_LICENSE_KEY=xxxxx

# "country" (default, ~9 MB database) or "full" (city/region, ~61 MB database)
# GEOLOCATION_MODE=country

# Optional: look up each visitor's network (ASN) to improve bot detection.
# Downloads MaxMind's GeoLite2-ASN database with the credentials above;
# the app stops at boot if that download fails.
# ENABLE_ASN_LOOKUP=true

# --- Favicons ---
# Site icons in the dashboard are fetched server-side from DuckDuckGo (icons.duckduckgo.com),
# which learns each domain whose icon is shown. Set to false to stop these requests.
# PUBLIC_ENABLE_FAVICON_FETCHING=false

# --- Background Jobs ---
# Runs the background worker: all outgoing email (password reset, invitations, alerts,
# reports) and the data-retention cleanup. Setting false stops all of them. Enabled by default.
# BACKGROUND_JOBS_ENABLED=true

# --- Telemetry ---
# Once a day this instance sends {instance_id, version} to https://betterlytics.io/telemetry.
# instance_id is a random UUID stored in your database; no IP address or other data is stored.
# Enabled by default. Set to false to turn it off; DO_NOT_TRACK=1 also turns it off.
# Details: https://betterlytics.io/docs/installation/self-hosting#telemetry
# TELEMETRY_ENABLED=false

# --- Logging ---
# Backend log level: error, warn, info (default), debug or trace.
# LOG_LEVEL=info

# --- Updates ---
# Boot stops when this repo and the image are on different versions.
# Only set this if you run a custom image on purpose.
# SKIP_VERSION_CHECK=true

# --- Notification Integrations ---
# Only needed if you use Pushover for uptime alerts.
# PUSHOVER_APP_TOKEN=

# --- Private Network Targets ---
# Lets uptime monitors and webhooks reach LAN/private addresses (e.g. 192.168.x.x, host.docker.internal).
# Enabled by default. Any user who can edit a dashboard can then probe your LAN, so set this to false
# on instances with open registration or untrusted users.
# Loopback (127.0.0.1, localhost) is always blocked: reach services on the Docker host through
# its LAN IP or host.docker.internal.
# ALLOW_PRIVATE_TARGETS=true

# --- Session Replay ---
# Enabled by default. Recordings are stored in ClickHouse, no extra services needed.
# SESSION_REPLAYS_ENABLED=false

# Days to keep recordings (default 60, independent of DATA_RETENTION_DAYS). Use -1 to keep indefinitely.
# Applies to ClickHouse storage only; with S3, expire the site/ prefix with your own bucket lifecycle rule.
# REPLAY_RETENTION_DAYS=60

# Optional: store recordings in your own S3-compatible storage instead of ClickHouse.
# The endpoint only needs to be reachable from the containers, never from browsers.
# S3_ENABLED=true
# S3_BUCKET=betterlytics-replays
# S3_REGION=eu-central-1
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Required for most non-AWS providers (MinIO, Garage, etc.)
# S3_FORCE_PATH_STYLE=true
# Optional: request server-side encryption (SSE-S3, AES256) for uploaded recordings.
# S3_SSE_ENABLED=true

# Storage backend override: "clickhouse" or "s3".
# Unset resolves to s3 when S3_ENABLED=true, else clickhouse.
# REPLAY_STORAGE=clickhouse
